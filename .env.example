# Optional: npm run dev works without creating this file.
# Copy to .env.local only to override these defaults.
API_PORT=3001
VITE_PORT=5173
# The frontend and API use the same browser origin through Vite's proxy.
VITE_API_BASE_URL=/api
# A database file is created automatically. Never commit it to Git.
DATABASE_PATH=./data/crmsales.sqlite
# npm start serves both the production frontend and API on this port.
PORT=3001
HOST=127.0.0.1
